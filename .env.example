# Copy to .env for local dev (`just` loads it). In production set these as secrets/env vars.

# --- Server ---
# PORT=3000
# STATIC_DIR=web/dist
# Everything the app stores: the SQLite database and each organisation's files
# (orgs/<slug>/documents, ...). Created if missing. Point this at persistent storage when hosting.
DATA_DIR=data
# Largest document upload, in MB.
MAX_UPLOAD_MB=10
# CLIENT_IP_HEADER=x-forwarded-for  # set when behind a reverse proxy (Railway, Caddy, ...)

# --- Captcha (ALTCHA) ---
# ALTCHA_HMAC_KEY=                  # openssl rand -hex 32; random per process if unset

# --- Sign-in ---
# Public origin of the site. Dev goes through the Vite proxy, so use :5173.
PUBLIC_URL=http://localhost:5173
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: $PUBLIC_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that get admin access when they sign in (verified emails only).
ADMIN_EMAILS=
